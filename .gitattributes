# Normalize text file line endings
* text=auto

# Source code and configuration
*.cs text eol=lf
*.csproj text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf
*.http text eol=lf

# Binary image assets
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
